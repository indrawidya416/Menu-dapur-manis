# Kredensial Supabase — salin file ini menjadi ".env" lalu isi nilainya.
# Dapatkan dari: Supabase Dashboard → Project Settings → API
#
# CATATAN: anon key bersifat publik (aman dipakai di frontend). Keamanan
# data dijaga oleh Row Level Security (RLS) di database, bukan oleh key ini.
# JANGAN gunakan service_role key di frontend.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
